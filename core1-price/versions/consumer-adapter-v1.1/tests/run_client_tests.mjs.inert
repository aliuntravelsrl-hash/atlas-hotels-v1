// Client adapter v1.1 tests (SIMULATED server DTOs dumped by run_server_scenarios; no network, SQL or app). usage: node run_client_tests.mjs <dtos.json> <internal_view.json>
import fs from "node:fs";
import * as A from "./core1PriceAdapter.mjs";
const fx = JSON.parse(fs.readFileSync(process.argv[2], "utf8")).dtos;
const iv = JSON.parse(fs.readFileSync(process.argv[3], "utf8"));
const EXPECTED = 24;
const results = {};
const check = (n, ok, d = "") => { results[n] = { status: ok ? "PASS" : "FAIL", detail: ok ? "" : String(d) }; };
const mk = (rooms) => A.buildQuoteRequest({ requestId: "r", hotelRef: "H", providerPlanRef: "P", rooms, checkIn: "2027-01-01", checkOut: "2027-01-02", currency: "USD" });
const base = fx.base;

check("C01_integer_ages_request_built_with_v1_1_contract", (() => { const r = mk([{ roomRef: "R", adults: 2, childAges: [5], agesConfirmed: true }]); return !!r.request && r.request.contract_version === "CORE1-PRICE-CONSUMER-ADAPTER-v1.1" && r.request.rooms[0].ages_confirmed === true; })());
check("C02_non_integer_or_out_of_range_age_blocked_before_request", [[5.5], [5.0 + 0.1], ["5"], [18], [-1], [null], [true]].every((a) => mk([{ roomRef: "R", adults: 2, childAges: a, agesConfirmed: true }]).error === "AGE_INVALID"));
check("C03_unconfirmed_ages_blocked", mk([{ roomRef: "R", adults: 2, childAges: [5] }]).error === "AGES_NOT_CONFIRMED");
check("C04_no_room_or_invalid_adults_no_request", mk([]).error === "ROOM_NOT_SELECTED" && mk([{ roomRef: "R", adults: 0, childAges: [] }]).error === "REQUEST_INVALID");
check("C05_request_has_no_authority_fields", (() => { const r = mk([{ roomRef: "R", adults: 2, childAges: [5], agesConfirmed: true }]).request; const k = Object.keys(r).concat(Object.keys(r.rooms[0])); return !k.some((x) => /total|price|rate|margin|nights|ctx|fx|deposit|flag|received/.test(x)); })());
const t = A.createTracker(); t.begin("OLD"); t.begin("Q1");
check("C06_old_response_ignored_latest_accepted", t.accept({ ...base, request_id: "OLD" }) === false && t.accept(base) === true && t.current.request_id === "Q1");
check("C07_other_dto_version_refused_not_translated", (() => { const t2 = A.createTracker(); t2.begin("Q1"); return t2.accept({ ...base, dto_version: "CORE1-PRICE-PUBLIC-DTO-v1" }) === false; })());
check("C08_input_change_invalidates", (() => { t.invalidate(); return t.current === null && t.accept(base) === false; })());
const v = A.toQuoteView(base);
check("C09_view_reference_only_never_payable_never_enabled", v.hasPrice && v.referenceTotal === "200.00" && v.payable === false && v.totalCertified === false && v.bookingEnabled === false && v.collectionAllowed === false && v.bookingNeedsOperator === true);
check("C10_no_default_cancellation_policy_average_not_rate", v.cancellationPolicy === null && v.averageIsRate === false);
check("C11_reclassified_age_shows_billed_adults", (() => { const r = A.toQuoteView(fx.reclass); return r.adultsBilled[0] === 3 && r.childrenBilled[0] === 0 && r.notes.some((n) => n.code === "AGE_RECLASSIFIED_AS_ADULT"); })());
check("C12_child_not_reclassified_shows_child_billed", (() => { const r = A.toQuoteView(fx.child12); return r.adultsBilled[0] === 2 && r.childrenBilled[0] === 1 && !r.notes.some((n) => n.code === "AGE_RECLASSIFIED_AS_ADULT"); })());
check("C13_tax_and_supplement_are_notes_total_not_certified", (() => { const a = A.toQuoteView(fx.tax_unknown); const b = A.toQuoteView(fx.supplement); return a.notes.some((n) => n.code === "TAX_NOTE") && a.totalCertified === false && b.notes.some((n) => n.code === "SUPPLEMENT_NOTE") && b.referenceTotal === "200.00"; })());
check("C14_dop_and_usd_hooks_do_not_convert_in_browser", (() => { const u = A.toRoomPricingLegacyShape(base, "R"); const d = A.toRoomPricingLegacyShape(fx.fx_ok, "R"); return u.total_usd === "200.00" && u.total_dop === null && d.total_dop === "12400.00" && d.total_usd === null && u.reference_only === true; })());
const NOPRICE = ["net", "cap_exceeded", "cap_unknown", "fx_drift", "dop_to_usd_nofx", "engine_mismatch", "context_mismatch", "contract_v1", "rpc_fail", "paused", "overlap_tie", "future_only", "ages_unconfirmed", "core2", "other_hotel", "no_room", "forbidden_field"];
check("C15_every_no_price_dto_gives_no_price_and_no_fallback", NOPRICE.every((k) => { const q = A.toQuoteView(fx[k]); const h = A.toHotelPricingView(fx[k]); const r = A.toRoomPricingLegacyShape(fx[k], "R"); const e = A.toUnifiedEngineView(fx[k]);
  return !q.hasPrice && q.payable === false && q.bookingEnabled === false && h.priceRange === null && r.success === false && r.price_per_night === null && e.ratePlans.length === 0 && e.mocksIncluded === false; }), NOPRICE.filter((k) => A.toQuoteView(fx[k]).hasPrice).join());
check("C16_comparator_without_price_is_null_not_zero", (() => { const c = A.toComparatorEntry({ h: 1 }, fx.rpc_fail); return c.price === null && c.snapshot === null && c.cancellation === null; })());
check("C17_comparator_keeps_snapshot_and_marks_reference_only", (() => { const c = A.toComparatorEntry({ h: 1 }, base); return c.price.amount === "200.00" && c.price.referenceOnly === true && !!c.snapshot.fingerprint && c.cancellation === null; })());
check("C18_expired_snapshot_detected", (() => { const c = A.toComparatorEntry({ h: 1 }, base); return A.comparatorEntryExpired(c, "2026-10-23T14:31:00Z") === true && A.comparatorEntryExpired(c, "2026-10-23T14:05:00Z") === false; })());
check("C19_card_catalog_reference_not_purchasable_and_quote_overrides", (() => { const g = { governed: true, from_amount: "90.00", currency: "USD", unit_label: "PER_PERSON_NIGHT_FROM" }; const c = A.toCardView(g, null); return c.kind === "CATALOG_REFERENCE" && c.purchasable === false && A.toCardView(g, base).kind === "QUOTE" && A.toCardView({ governed: false, from_amount: "5" }, null).kind === "CONSULT"; })());
check("C20_admin_view_same_no_override", A.toAdminQuotationView(base).adminOverride === false && A.toAdminQuotationView(base).referenceTotal === "200.00");
const op = A.toOperatorView(iv.expired_condition);
check("C21_operator_sees_expiry_alert_and_must_consult_provider", op.available && op.mustConsultProvider === true && op.alerts[0].status === "VENCIDA" && op.collectionAllowed === false);
check("C22_operator_view_provider_amount_is_not_client_price_and_no_confirmed_final", (() => { const n = A.toOperatorView(iv.net); return n.providerAmount.amount === "200.00" && n.providerAmountIsClientPrice === false && n.finalPriceConfirmed === null; })());
check("C23_operator_view_refuses_foreign_or_missing_view", A.toOperatorView(base).available === false && A.toOperatorView(null).available === false);
const code = fs.readFileSync(new URL("./core1PriceAdapter.mjs", import.meta.url), "utf8").split("\n").filter((l) => !l.trim().startsWith("//")).join("\n");
const banned = [/58\.5/, /\b0\.5\b/, /free_7d/, /cancelaci[oó]n gratuita/i, /\|\|\s*0\b/, /base_price/, /min_price/, /MOCK_/, /service_role/, /parseFloat|Number\(/, /\*\s*[0-9]/];
check("C24_lint_no_legacy_computation_or_defaults", banned.every((r) => !r.test(code)), banned.filter((r) => r.test(code)).join(" "));
const names = Object.keys(results); const bad = names.filter((k) => results[k].status === "FAIL");
for (const k of names) console.log(k, results[k].status, results[k].detail);
console.log(`CLIENT TESTS v1.1 (simulated DTOs): ${names.length - bad.length}/${names.length} PASS; failing=${JSON.stringify(bad)}`);
if (names.length !== EXPECTED) { console.log(`COUNT MISMATCH: ${names.length}, expected ${EXPECTED}`); process.exit(2); }
process.exit(bad.length ? 1 : 0);
