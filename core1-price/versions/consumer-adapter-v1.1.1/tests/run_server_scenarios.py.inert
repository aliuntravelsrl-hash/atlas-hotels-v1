@sc("S38_R4_provider_amount_only_when_every_used_row_declares_net_provider")
def _():
    out = {}
    for name, rows in (("client_final", [row()]), ("net", [NET()]), ("unknown", [row(price_basis="DESCONOCIDA")])):
        out[name] = internal(req(), state(rates=rows))["view"]
    mixed_r2 = NET(id="R2", received_at="2026-10-01T09:00:00Z", stay_from="2027-03-28", stay_until_exclusive="2027-03-29")
    r1 = row(id="R1", stay_from="2027-03-01", stay_until_exclusive="2027-03-28")
    rq = req(); rq["check_in"] = "2027-03-27"; rq["check_out"] = "2027-03-29"
    out["mixed"] = internal(rq, state(rates=[r1, mixed_r2]))["view"]
    cf, nt, un, mx = out["client_final"], out["net"], out["unknown"], out["mixed"]
    return (cf["provider_amount"] is None and cf["provider_amount_status"] == "NOT_ACCREDITED_CLIENT_FINAL" and cf["source_subtotal"]["basis"] == "CLIENT_FINAL"
            and nt["provider_amount"]["amount"] == "200.00" and nt["provider_amount_status"] == "ACCREDITED"
            and un["provider_amount"] is None and un["provider_amount_status"] == "NOT_ACCREDITED_UNKNOWN" and un["source_subtotal"]["basis"] == "UNKNOWN"
            and mx["provider_amount"] is None and mx["provider_amount_status"] == "NOT_ACCREDITED_MIXED"), out

@sc("S39_R4_no_margin_fx_or_final_price_invented_and_public_never_sees_bases")
def _():
    views = [internal(req(), state(rates=rs))["view"] for rs in ([row()], [NET()], [row(price_basis="X")])]
    keys = set(); [keys.update(_keys(v)) for v in views]
    pubs = [S.quote_public(req(), state(rates=rs)) for rs in ([row()], [NET()], [row(price_basis="X")])]
    s_ = json.dumps(pubs)
    return (not any("margin" in k or "markup" in k for k in keys) and all(v["final_price_confirmed"] is None for v in views)
            and "CLIENT_FINAL" not in s_ and "NET_PROVIDER" not in s_ and "INTERNAL_" not in s_ and "basis" not in s_), (sorted(keys)[:5], s_[:80])

# ---- R5: schema validation (real jsonschema if importable; otherwise a built-in subset validator, labelled)
SCHEMA = json.load(open(os.path.join(HERE, "..", "CORE1-PRICE-PUBLIC-DTO-v1.1.1.schema.json.inert")))
try:
    import jsonschema
    import importlib.metadata as _im; VALIDATOR = "jsonschema " + _im.version("jsonschema")
    jsonschema.Draft202012Validator.check_schema(SCHEMA)
    def valid(doc): return jsonschema.Draft202012Validator(SCHEMA).is_valid(doc)
except ImportError:                              # offline fallback: declared, never silent
    VALIDATOR = "builtin-subset (jsonschema library NOT available)"
    import re as _re
    def _v(doc, sc_):
        if "oneOf" in sc_: return sum(_v(doc, x) for x in sc_["oneOf"]) == 1
        if "const" in sc_ and doc != sc_["const"]: return False
        if "enum" in sc_ and doc not in sc_["enum"]: return False
        t = sc_.get("type")
        if t:
            ok = {"object": isinstance(doc, dict), "array": isinstance(doc, list), "string": isinstance(doc, str), "null": doc is None,
                  "integer": isinstance(doc, int) and not isinstance(doc, bool)}[t]
            if not ok: return False
        if isinstance(doc, str):
            if "pattern" in sc_ and not _re.search(sc_["pattern"], doc): return False
            if "minLength" in sc_ and len(doc) < sc_["minLength"]: return False
        if isinstance(doc, int) and not isinstance(doc, bool) and "minimum" in sc_ and doc < sc_["minimum"]: return False
        if isinstance(doc, list):
            if "minItems" in sc_ and len(doc) < sc_["minItems"]: return False
            if "maxItems" in sc_ and len(doc) > sc_["maxItems"]: return False
            if "items" in sc_ and not all(_v(x, sc_["items"]) for x in doc): return False
        if isinstance(doc, dict):
            if any(k not in doc for k in sc_.get("required", [])): return False
            props = sc_.get("properties", {})
            if sc_.get("additionalProperties") is False and set(doc) - set(props): return False
            if not all(_v(doc[k], props[k]) for k in doc if k in props): return False
        return True
    def valid(doc): return _v(doc, SCHEMA)
print("SCHEMA VALIDATOR:", VALIDATOR)

@sc("S40_R5_every_real_public_dto_validates_against_the_closed_schema")
def _():
    bad_ = [(d.get("request_id"), d.get("reason")) for d in ALL if not valid(d)]
    return not bad_ and len(ALL) >= 40, (bad_[:3], len(ALL))

def _mut(doc, fn):
    m = copy.deepcopy(doc); fn(m); return m
@sc("S41_R5_nested_mutations_of_a_priced_dto_are_rejected")
def _():
    b = DTOS["base"]
    muts = {
        "provider_amount_in_price": lambda m: m["price"].update(provider_amount={"amount": "1.00", "currency": "USD"}),
        "extra_in_reference_total": lambda m: m["price"]["reference_total"].update(basis="NET_PROVIDER"),
        "extra_in_average": lambda m: m["price"]["derived_average_per_night"].update(x=1),
        "extra_in_selection_room": lambda m: m["selection"]["rooms"][0].update(row_id="R1"),
        "extra_in_selection": lambda m: m["selection"].update(received_at="2026-01-01T00:00:00Z"),
        "internal_text_in_condition": lambda m: m["conditions"].append({"code": "REFERENCE_SUBJECT_TO_CONFIRMATION", "message_es": "x", "text": "Nino a 35"}),
        "unknown_condition_code": lambda m: m["conditions"].append({"code": "CONDITION_EXPIRED", "message_es": "x"}),
        "booking_enablement_empty": lambda m: m.update(booking_enablement={}),
        "booking_enablement_true": lambda m: m["booking_enablement"].update(derived_from_reference=True),
        "booking_enablement_missing_status": lambda m: m["booking_enablement"].pop("status"),
        "payable_true": lambda m: m["price"].update(payable=True),
        "total_certified_true": lambda m: m["price"].update(total_certified=True),
        "bad_amount_format": lambda m: m["price"]["reference_total"].update(amount="200"),
        "bad_currency": lambda m: m["price"]["reference_total"].update(currency="EUR"),
        "collection_true": lambda m: m.update(collection_allowed=True),
        "channel_extra": lambda m: m["channel"].update(token="x"),
        "missing_price": lambda m: m.pop("price"),
        "reason_not_null_on_price": lambda m: m.update(reason="PRICE_UNAVAILABLE"),
    }
    leaked = [k for k, f in muts.items() if valid(_mut(b, f))]
    return valid(b) and not leaked, leaked

@sc("S42_R5_no_price_branch_mutations_are_rejected")
def _():
    c = DTOS["cap_exceeded"]
    muts = {
        "price_not_null": lambda m: m.update(price={"reference_total": {"amount": "1.00", "currency": "USD"}}),
        "selection_present": lambda m: m.update(selection={}),
        "reason_unknown_raw_code": lambda m: m.update(reason="CAPACITY_EXCEEDED"),
        "reason_null_on_consult": lambda m: m.update(reason=None),
        "channel_present": lambda m: m.update(channel={"mode": "ASSISTED", "status": "ACCREDITED"}),
        "fingerprint_on_consult": lambda m: m.update(fingerprint="0" * 24),
        "enablement_true": lambda m: m["booking_enablement"].update(derived_from_reference=True),
        "condition_on_consult": lambda m: m.update(conditions=[{"code": "TAX_NOTE", "message_es": "x"}]),
        "extra_key": lambda m: m.update(warnings=["NET_BASIS_NOT_CLIENT_PRICE"]),
        "status_priced_without_price": lambda m: m.update(status="PRICE_REFERENCE"),
    }
    leaked = [k for k, f in muts.items() if valid(_mut(c, f))]
    return valid(c) and valid(DTOS["paused"]) and not leaked, leaked

@sc("S43_R5_schema_audit_every_object_is_closed_with_required_and_every_string_is_constrained")
def _():
    problems = []
    def walk(n, path):
        if isinstance(n, dict):
            if n.get("type") == "object":
                if n.get("additionalProperties") is not False: problems.append(path + ": object not closed")
                if "required" not in n: problems.append(path + ": object without required")
                if set(n.get("properties", {})) != set(n.get("required", [])): problems.append(path + ": required != properties")
            if n.get("type") == "string" and not any(k in n for k in ("pattern", "enum", "const", "minLength")): problems.append(path + ": free string")
            if n.get("type") == "array" and "items" not in n: problems.append(path + ": array without items")
            for k, v in n.items(): walk(v, path + "/" + k)
        elif isinstance(n, list):
            for i, v in enumerate(n): walk(v, path + f"[{i}]")
    walk(SCHEMA, "#")
    return not problems, problems[:5]

