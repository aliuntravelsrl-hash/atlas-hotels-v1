print(f"SERVER SCENARIOS v1.1.1 (simulated): {total - len(bad)}/{total} PASS; failing={json.dumps(bad)}")
if total != EXPECTED: print(f"COUNT MISMATCH: {total} scenarios, expected {EXPECTED}"); sys.exit(2)
