           "net": internal(req(), state(rates=[row(price_basis="NET_PROVIDER")]))["view"],
           "net_expired": internal(req(), state(rates=[row(price_basis="NET_PROVIDER", condition_notes=COND_EXP, mandatory_supplements=GALA)]))["view"],
           "client_final": internal(req(), state())["view"]}
    json.dump(ivs, open(sys.argv[sys.argv.index("--dump") + 1].replace(".json", "-internal.json"), "w"), indent=1, ensure_ascii=False, sort_keys=True)
