def cmany(q, x, r): r["condition_notes"] = [{"id": "C1", "text": "a", "expires_on": "2026-10-20"}, {"id": "C2", "text": "b", "expires_on": None}]
add("V22-F10", "condicion sin caducidad = VIGENTE; la otra vencida; monto igual", cmany,
    OKT("200.00", conditions=[{"row_id": "R1", "id": "C1", "text": "a", "expires_on": "2026-10-20", "status": "VENCIDA", "review_required": True},
                              {"row_id": "R1", "id": "C2", "text": "b", "expires_on": None, "status": "VIGENTE", "review_required": False}]))

# ---- G. Cambio de regla entre rangos (por noche)
def two_rows(age):
    def f(q, x, r):
        q["check_out"] = "2027-03-30"; room(q, child_ages=[age])
        r["stay_until_exclusive"] = "2027-03-29"
        r2 = copy.deepcopy(r)
        r2.update(id="R2", stay_from="2027-03-29", stay_until_exclusive="2027-04-01")
        r2["occupancy_rates"] = {"SGL": "170", "DBL": "120", "TPL": "110"}
        r2["age_policy"] = {"adult_from_age": 12, "bands": [
            {"label": "INFANT", "from_age": 0, "to_age": 2, "price": {"mode": "FREE"}, "max_per_room": 1},
            {"label": "CHILD", "from_age": 3, "to_age": 11, "price": {"mode": "FIXED_AMOUNT", "value": "35"}}]}
        x["rates"].append(r2)
    return f
add("V22-G01", "dos noches, dos reglas: noche1 250 (50% de 100) + noche2 275 (120x2 + 35) = 525", two_rows(5), OKT("525.00", displayed_nightly_amounts=["250.00", "275.00"]))
add("V22-G02", "edad 12: nino en noche1 (corte 13) y adulto en noche2 (corte 12): 250 + 330 = 580", two_rows(12), OKT("580.00", displayed_nightly_amounts=["250.00", "330.00"]))
def gap(q, x, r): q["check_out"] = "2027-03-31"; r["stay_until_exclusive"] = "2027-03-30"
add("V22-G03", "noche sin cobertura => Consultar", gap, INC("RATE_COVERAGE_GAP"))
def amb(q, x, r): r2 = copy.deepcopy(r); r2["id"] = "R2"; x["rates"].append(r2)
add("V22-G04", "rangos solapados sin received_at => Consultar", amb, INC("RATE_AMBIGUOUS"))
def ov(r1_date, r2_date, r2_from=None, r2_until=None, r2_dbl="120", r2_patch=None):
    def f(q, x, r):
        r["received_at"] = r1_date
        r2 = copy.deepcopy(r); r2["id"] = "R2"; r2["occupancy_rates"]["DBL"] = r2_dbl
        if r2_date is None: r2.pop("received_at")
        else: r2["received_at"] = r2_date
        if r2_from: r2["stay_from"] = r2_from
        if r2_until: r2["stay_until_exclusive"] = r2_until
        if r2_patch: r2_patch(r2)
        x["rates"].append(r2)
    return f
add("V22-G05", "solape: la fila mas reciente manda (R2 nueva DBL 120 sobre R1 vieja) = 240", ov("2026-09-01T09:00:00Z", "2026-10-01T09:00:00Z"), OKT("240.00", superseded_rates=[{"row_id": "R2", "supersedes": ["R1"]}]))
add("V22-G06", "manda la mas reciente aunque sea la mas larga (R1 larga nueva gana a R2 corta vieja) = 200", ov("2026-10-01T09:00:00Z", "2026-09-01T09:00:00Z", "2027-03-27", "2027-03-30"), OKT("200.00", superseded_rates=[{"row_id": "R1", "supersedes": ["R2"]}]))
add("V22-G07", "empate exacto de instante de ingesta => Consultar", ov("2026-10-01T09:00:00Z", "2026-10-01T09:00:00Z"), INC("RATE_AMBIGUOUS"))
add("V22-G08", "una de las filas sin received_at => Consultar", ov("2026-10-01T09:00:00Z", None), INC("RATE_AMBIGUOUS"))
def unv(r2): r2["verification_status"] = "PENDING"
add("V22-G09", "fila mas reciente NO verificada no desplaza a la vigente anterior = 200", ov("2026-09-01T09:00:00Z", "2026-10-01T09:00:00Z", r2_patch=unv), OKT("200.00", superseded_rates=None))
def ina(r2): r2["is_active"] = False
add("V22-G10", "fila mas reciente inactiva no desplaza a la vigente anterior = 200", ov("2026-09-01T09:00:00Z", "2026-10-01T09:00:00Z", r2_patch=ina), OKT("200.00", superseded_rates=None))
def plc(r2): r2["placeholder"] = True
add("V22-G11", "fila mas reciente placeholder no desplaza = 200", ov("2026-09-01T09:00:00Z", "2026-10-01T09:00:00Z", r2_patch=plc), OKT("200.00", superseded_rates=None))
def both_bad(r2): r2["is_active"] = False
add("V22-G12", "solape sin ninguna fila vigente => error de la primera (inactiva)", lambda q, x, r: (r.update(is_active=False, received_at="2026-09-01T09:00:00Z"), ov("2026-09-01T09:00:00Z", "2026-10-01T09:00:00Z", r2_patch=both_bad)(q, x, r)), INC("RATE_NOT_ACTIVE"))
add("V22-G13", "received_at invalida", lambda q, x, r: r.update(received_at="2026-13-40T00:00:00Z"), INV)
add("V22-G14", "fila unica con received_at: sin nota de reemplazo", lambda q, x, r: r.update(received_at="2026-10-01T09:00:00Z"), OKT("200.00", superseded_rates=None))
add("V22-G15", "mismo dia, hora distinta: manda la ingesta mas tardia (R2 15:00 sobre R1 09:00) = 240", ov("2026-10-01T09:00:00Z", "2026-10-01T15:00:00Z"), OKT("240.00", superseded_rates=[{"row_id": "R2", "supersedes": ["R1"]}]))
add("V22-G16", "mismo dia, la fila vieja de hora tardia gana a la nueva de hora temprana (R1 15:00 sobre R2 09:00) = 200", ov("2026-10-01T15:00:00Z", "2026-10-01T09:00:00Z"), OKT("200.00", superseded_rates=[{"row_id": "R1", "supersedes": ["R2"]}]))
add("V22-G17", "diferencia de un segundo decide (R2 +1s) = 240", ov("2026-10-01T09:00:00Z", "2026-10-01T09:00:01Z"), OKT("240.00", superseded_rates=[{"row_id": "R2", "supersedes": ["R1"]}]))
add("V22-G18", "received_on (solo fecha) ya no ordena: dos filas con fecha y sin instante => Consultar", lambda q, x, r: (r.update(received_on="2026-09-01"), x["rates"].append(dict(copy.deepcopy(r), id="R2", received_on="2026-10-01"))), INC("RATE_AMBIGUOUS"))
add("V22-G19", "received_at sin zona (no UTC) es invalido", lambda q, x, r: r.update(received_at="2026-10-01T09:00:00"), INV)
add("V22-G20", "misma hora en distinta notacion de fraccion es empate => Consultar", ov("2026-10-01T09:00:00Z", "2026-10-01T09:00:00.000Z"), INC("RATE_AMBIGUOUS"))
# ---- moneda del monto fijo: la dicta la fila, no el sistema (decision del Director 23-Oct 11:39)
def dop_fixed(q, x, r):
    q["payment_currency"] = "DOP"; room(q, child_ages=[5])
    r["currency"] = "DOP"; r["occupancy_rates"] = {"SGL": "9000", "DBL": "6000", "TPL": "5400"}
    band(r, "CHILD", price={"mode": "FIXED_AMOUNT", "value": "2000"}); x["fx"] = []
add("V22-J01", "monto fijo de nino en DOP en fila DOP, pago DOP, sin FX: 2x6000 + 2000 = 14000", dop_fixed, OKT("14000.00"))
def dop_fixed_usd(q, x, r):
    dop_fixed(q, x, r); q["payment_currency"] = "USD"; x["fx"] = []
add("V22-J02", "fila DOP pagada en USD sin FX => Consultar (no se usa tasa propia)", dop_fixed_usd, INC("FX_MISSING"))

