# ---- F. Condiciones con caducidad: estado sin alterar el monto (R6)
def cexp(q, x, r): r["condition_notes"] = [{"id": "C1", "text": "Nino a 35 hasta 20-Oct", "expires_on": "2026-10-20"}]
add("V22-F01", "condicion vencida: mismo monto y estado VENCIDA con revision requerida", cexp,
    OKT("200.00", conditions=[{"row_id": "R1", "id": "C1", "text": "Nino a 35 hasta 20-Oct", "expires_on": "2026-10-20", "status": "VENCIDA", "review_required": True}],
        warnings=["CONDITION_EXPIRED_CONFIRM_WITH_PROVIDER"], may_request_booking=True))
def cok(q, x, r): r["condition_notes"] = [{"id": "C1", "text": "x", "expires_on": "2026-12-31"}]
add("V22-F02", "condicion vigente", cok, OKT("200.00", conditions=[{"row_id": "R1", "id": "C1", "text": "x", "expires_on": "2026-12-31", "status": "VIGENTE", "review_required": False}], warnings=None))
def cnot(q, x, r): r["condition_notes"] = [{"id": "C1", "text": "x", "expires_on": "2026-11-01"}]
add("V22-F03", "sin plazo de aviso configurado no hay POR_VENCER", cnot, OKT("200.00", conditions=[{"row_id": "R1", "id": "C1", "text": "x", "expires_on": "2026-11-01", "status": "VIGENTE", "review_required": False}]))
def cnot2(q, x, r): cnot(q, x, r); x["policy"] = {"review_notice_days": 14}
add("V22-F04", "con aviso de 14 dias, 9 dias restantes => POR_VENCER", cnot2, OKT("200.00", conditions=[{"row_id": "R1", "id": "C1", "text": "x", "expires_on": "2026-11-01", "status": "POR_VENCER", "review_required": True}], warnings=["CONDITION_EXPIRING_CONFIRM_WITH_PROVIDER"]))
def cday(q, x, r): r["condition_notes"] = [{"id": "C1", "text": "x", "expires_on": "2026-10-23"}]
add("V22-F05", "vence hoy: sigue vigente (ultimo dia inclusivo)", cday, OKT("200.00", conditions=[{"row_id": "R1", "id": "C1", "text": "x", "expires_on": "2026-10-23", "status": "VIGENTE", "review_required": False}]))
add("V22-F06", "ventana de venta cerrada ya no bloquea: condicion VENCIDA y mismo monto", lambda q, x, r: r.update(sale_until_exclusive="2026-10-22T00:00:00Z"),
    OKT("200.00", conditions=[{"row_id": "R1", "id": "SALE_WINDOW", "text": None, "expires_on": "2026-10-22T00:00:00Z", "status": "VENCIDA", "review_required": True}], warnings=["CONDITION_EXPIRED_CONFIRM_WITH_PROVIDER"]))
