add("V22-B05", "nino a 35 fijo con 1 adulto = 150 + 35 = 185", lambda q, x, r: (room(q, adults=1, child_ages=[5]), band(r, "CHILD", price={"mode": "FIXED_AMOUNT", "value": "35"})), OKT("185.00"))
add("V22-B06", "porcentaje 35% sobre DBL: 2A+1N = 235", lambda q, x, r: (room(q, child_ages=[5]), band(r, "CHILD", price={"mode": "PERCENT_OF_DBL", "value": "35"})), OKT("235.00"))
add("V22-B07", "sin banda para la edad => Consultar", lambda q, x, r: (room(q, child_ages=[5]), r["age_policy"]["bands"].pop(1)), INC("CHILD_PRICE_UNDEFINED"))
add("V22-B08", "porcentaje sobre DBL pero DBL ausente => Consultar", lambda q, x, r: (room(q, adults=1, child_ages=[5]), r["occupancy_rates"].pop("DBL")), INC("CHILD_PRICE_UNDEFINED"))
