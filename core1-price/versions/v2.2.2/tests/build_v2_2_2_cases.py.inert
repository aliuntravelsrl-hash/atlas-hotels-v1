"""Genera (v2.2.2) CORE1-BASE-PRICE-REGRESSION-v2.2.2-ATLAS-TECH.json (vectores SINTETICOS).
Las cifras 100/150/50% provienen del ejemplo del Director (23-Oct-2026); TPL 90, QUAD 85 y demas son inventadas
para ejercitar el modelo. No son tarifas de ningun hotel real.
Uso: python3 -I build_v2_2_2_cases.py   (escribe el JSON en el directorio padre)
"""
import copy
import json
import os

HERE = os.path.dirname(os.path.abspath(__file__))
OUT = os.path.join(HERE, "..", "CORE1-BASE-PRICE-REGRESSION-v2.2.2-ATLAS-TECH.json")

AGE_POLICY = {
    "adult_from_age": 13,
    "bands": [
        {"label": "INFANT", "from_age": 0, "to_age": 2, "price": {"mode": "FREE"}, "max_per_room": 1},
        {"label": "CHILD", "from_age": 3, "to_age": 12, "price": {"mode": "PERCENT_OF_DBL", "value": "50"}},
    ],
}
ROW = {
    "id": "R1", "revision": 1, "hotel_id": "H1", "provider_id": "P1", "room_type_id": "RT1",
    "stay_from": "2027-03-01", "stay_until_exclusive": "2027-04-01", "currency": "USD", "unit": "PERSON_NIGHT",
    "placeholder": False, "is_active": True, "verification_status": "VERIFIED",
    "review_evidence_ref": "SYNTH-REVIEW", "source_document_id": "SYNTH-DOC", "price_basis": "CLIENT_FINAL",
    "taxes_included": True,
    "occupancy_rates": {"SGL": "150", "DBL": "100", "TPL": "90"},
    "age_policy": AGE_POLICY,
    "capacity": {"max_total": 4, "max_adults": 3, "max_children": 2},
}
FX = {"id": "FX1", "pair": "USD_DOP", "direction": "DOP_PER_USD", "rate_sell": "62", "active": True,
      "effective_from": "2026-10-23T00:00:00Z", "effective_until_exclusive": "2026-10-23T23:00:00Z",
      "approved_by_ref": "SYNTH-APPROVER", "source_ref": "SYNTH-SRC", "source_version": "SYNTH-V1"}


def mk(id_, title, mut, exp):
    c = {
        "id": id_, "title": title, "schema_version": "CORE1-PRICE-ACCEPTANCE-v2.2.2",
        "request": {"request_id": id_, "hotel_id": "H1", "provider_id": "P1", "check_in": "2027-03-28",
                    "check_out": "2027-03-29", "payment_currency": "USD", "server_now": "2026-10-23T14:00:00Z",
                    "rooms": [{"room_type_id": "RT1", "adults": 2, "child_ages": []}]},
        "context": {"schema_version": "CORE1-PRICE-CONTEXT-v2.2.2", "accepted_payment_currencies": ["USD", "DOP"],
                    "deposit_policy": {"type": "FULL_PAYMENT"}, "rates": [copy.deepcopy(ROW)], "fx": [copy.deepcopy(FX)]},
    }
    mut(c["request"], c["context"], c["context"]["rates"][0])
    c["expected"] = exp
    return c


INC = lambda code: {"calculation_status": "INCOMPLETE", "commercial_use": "NO_COMPLETE_QUOTE", "payment_total": None,
                    "deposit_preview": None, "error_code": code, "collection_allowed": False}
INV = {"calculation_status": "INVALID", "commercial_use": "NO_COMPLETE_QUOTE", "payment_total": None,
       "deposit_preview": None, "error_code": "INPUT_INVALID", "collection_allowed": False}


def OKT(total, **kw):
    d = {"calculation_status": "COMPLETE", "payment_total": total, "display_label": "REFERENCE_SUBJECT_TO_CONFIRMATION",
         "collection_allowed": False, "engine_version": "CORE1-PRICE-ENGINE-v2.2.2"}
    d.update(kw)
    return d


cases = []
def add(*a): cases.append(mk(*a))
def room(q, **kw): q["rooms"][0].update(kw)
def band(r, label, **kw):
    for b in r["age_policy"]["bands"]:
        if b["label"] == label:
            b.update(kw)


# ---- A. Base por cantidad de adultos (R3) con cifras del Director
add("V22-A00", "2 adultos DBL 100 pp = 200; el desglose muestra base DBL", lambda q, x, r: None,
    OKT("200.00", displayed_nightly_amounts=["200.00"], room_breakdown=[{"room_index": 0, "nights": [
        {"night": "2027-03-28", "row_id": "R1", "revision": 1, "base": "DBL", "adults_declared": 2, "adults_effective": 2,
         "reclassified_ages": [], "adult_unit_amount": "100.00", "adult_amount": "200.00", "children": []}]}]))
add("V22-A01", "1 adulto => base SGL 150", lambda q, x, r: room(q, adults=1), OKT("150.00"))
add("V22-A02", "3 adultos => base TPL 90 pp = 270", lambda q, x, r: room(q, adults=3), OKT("270.00"))
add("V22-A03", "4 adultos sobre max_adults 3 => capacidad", lambda q, x, r: room(q, adults=4), INC("CAPACITY_EXCEEDED"))
def quad(q, x, r):
    room(q, adults=4); r["occupancy_rates"]["QUAD"] = "85"; r["capacity"].update(max_adults=4, max_total=4)
add("V22-A04", "4 adultos con QUAD declarado = 340", quad, OKT("340.00"))
def quad_missing(q, x, r):
    room(q, adults=4); r["capacity"].update(max_adults=5, max_total=5)
add("V22-A05", "4 adultos sin QUAD declarado => Consultar (no se deduce)", quad_missing, INC("OCCUPANCY_PRICE_UNDEFINED"))
add("V22-A06", "SGL ausente con 1 adulto => Consultar (no se deriva de DBL)", lambda q, x, r: (room(q, adults=1), r["occupancy_rates"].pop("SGL")), INC("OCCUPANCY_PRICE_UNDEFINED"))

