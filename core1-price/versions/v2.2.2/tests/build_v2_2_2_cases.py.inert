add("V22-B13", "bandas superpuestas => ambiguo", lambda q, x, r: (room(q, child_ages=[5]), band(r, "CHILD", from_age=2)), INC("CHILD_BANDS_AMBIGUOUS"))
add("V22-B14", "edad 2 = bebe gratis (limite superior inclusivo)", lambda q, x, r: room(q, child_ages=[2]), OKT("200.00"))
