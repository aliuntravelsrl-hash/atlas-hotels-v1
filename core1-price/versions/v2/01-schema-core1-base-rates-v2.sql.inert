-- INERT / NOT APPLIED / NO DDL EXECUTED. ATLAS-TECH (AP-03) · 2026-10-22 · v2 (CS-R4, CS-R5, CS-R6, CS-R9).
-- Candidate direction only (Curator: Option B closed tables as candidate; no DDL authorised). v1 file kept in ../core1-price-v1.
-- Server authority: no client payload is ever stored or read as a rate. Only service_role writes, via a future server function.
BEGIN;

CREATE TABLE public.core1_source_documents (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  contract_code text NOT NULL, form_code text, revision text NOT NULL,
  sha256 text NOT NULL CHECK (sha256 ~ '^[0-9a-f]{64}$'),
  size_bytes bigint NOT NULL CHECK (size_bytes > 0),
  signature_status text NOT NULL DEFAULT 'UNKNOWN' CHECK (signature_status IN ('UNKNOWN','UNSIGNED','SIGNED')),
  signature_required_for_reference boolean NOT NULL DEFAULT false,
  signature_required_for_sale boolean NOT NULL DEFAULT true,
  captured_at timestamptz NOT NULL DEFAULT now(),
  notes text,  -- no names, e-mails, phones, signatures
  UNIQUE (contract_code, revision, sha256)
);

-- Explicit map room (legacy public.rooms) <-> hotel <-> provider <-> plan. A rate cannot reference a room of another hotel.
CREATE TABLE public.core1_room_map (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  hotel_id uuid NOT NULL REFERENCES public.hotels_master(id) ON DELETE RESTRICT,
  provider_id text NOT NULL,
  plan text,
  room_id uuid NOT NULL REFERENCES public.rooms(id) ON DELETE RESTRICT,
  source_room_label text NOT NULL,
  mapping_status text NOT NULL DEFAULT 'UNKNOWN' CHECK (mapping_status IN ('UNKNOWN','CANDIDATE','CONFIRMED')),
  confirmed_by_ref text, confirmed_evidence_ref text,
  max_adults int CHECK (max_adults IS NULL OR max_adults >= 1),
  max_children int CHECK (max_children IS NULL OR max_children >= 0),
  CHECK (mapping_status <> 'CONFIRMED' OR (confirmed_by_ref IS NOT NULL AND confirmed_evidence_ref IS NOT NULL)),
  UNIQUE (hotel_id, provider_id, plan, room_id),
  UNIQUE (id, hotel_id, provider_id)
);

CREATE TABLE public.core1_base_rates (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  revision integer NOT NULL DEFAULT 1 CHECK (revision >= 1),
  supersedes_id uuid REFERENCES public.core1_base_rates(id) ON DELETE RESTRICT,
  hotel_id uuid NOT NULL,
  provider_id text NOT NULL,
  room_map_id uuid NOT NULL,
  plan text,
  FOREIGN KEY (room_map_id, hotel_id, provider_id) REFERENCES public.core1_room_map(id, hotel_id, provider_id) ON DELETE RESTRICT,
  stay_from date NOT NULL, stay_until_exclusive date NOT NULL,
  source_range_text text NOT NULL, source_range_end_inclusive boolean NOT NULL,
  CHECK (stay_until_exclusive > stay_from),
  unit text NOT NULL CHECK (unit IN ('PERSON_NIGHT','ROOM_NIGHT','PERSON_STAY','ROOM_STAY')),
  currency text NOT NULL CHECK (currency IN ('USD','DOP')),
  adult_pricing jsonb, amount numeric CHECK (amount >= 0),
  child_pricing jsonb, mandatory_supplements jsonb NOT NULL DEFAULT '[]'::jsonb,
  extra_pax_literal jsonb,  -- literal source figure, never read as triple (triple blocked, UNK)
  max_adults int CHECK (max_adults IS NULL OR max_adults >= 1),
  max_children int CHECK (max_children IS NULL OR max_children >= 0),
  occupancy_included jsonb,
  -- net vs client basis is a first-class column (CS-R6): taxes_included NULL = UNK
  price_basis text NOT NULL DEFAULT 'UNKNOWN' CHECK (price_basis IN ('UNKNOWN','NET_PROVIDER','CLIENT_FINAL')),
  taxes_included boolean,
  sale_until_exclusive timestamptz,
  property_timezone text NOT NULL DEFAULT 'America/Santo_Domingo',
  group_min_rooms int CHECK (group_min_rooms IS NULL OR group_min_rooms >= 1),
  cutoff_policy text,
  provenance_kind text NOT NULL,
  -- verification missing/unknown never prices: default is NOT verified (CS-R3)
  verification_status text NOT NULL DEFAULT 'PENDING_REVIEW' CHECK (verification_status IN ('PENDING_REVIEW','VERIFIED','REJECTED')),
  captured_by text, captured_at timestamptz NOT NULL DEFAULT now(),
  reviewed_by text, reviewed_at timestamptz, review_evidence_ref text,
  is_placeholder boolean NOT NULL DEFAULT false,   -- exported to engine JSON as "placeholder" (explicit mapping)
  source_document_id uuid NOT NULL REFERENCES public.core1_source_documents(id) ON DELETE RESTRICT,
  source_ref text NOT NULL,
  is_active boolean NOT NULL DEFAULT false,
  activated_by text, activated_at timestamptz, activation_evidence_ref text,
  created_at timestamptz NOT NULL DEFAULT now(),
  CHECK ((unit IN ('PERSON_NIGHT','PERSON_STAY') AND adult_pricing IS NOT NULL) OR (unit IN ('ROOM_NIGHT','ROOM_STAY') AND amount IS NOT NULL)),
  CHECK (verification_status <> 'VERIFIED' OR (reviewed_by IS NOT NULL AND reviewed_at IS NOT NULL AND review_evidence_ref IS NOT NULL)),
  -- activation needs verification, not placeholder, client-final basis and an activation record (CS-R3)
  CHECK (NOT is_active OR (verification_status = 'VERIFIED' AND NOT is_placeholder AND activated_by IS NOT NULL AND activated_at IS NOT NULL AND activation_evidence_ref IS NOT NULL)),
  UNIQUE (room_map_id, stay_from, stay_until_exclusive, source_document_id, revision)
);

-- No overlapping ACTIVE ranges for the same room map (engine would otherwise fail closed with RATE_AMBIGUOUS).
CREATE EXTENSION IF NOT EXISTS btree_gist;
ALTER TABLE public.core1_base_rates ADD CONSTRAINT core1_no_active_overlap
  EXCLUDE USING gist (room_map_id WITH =, daterange(stay_from, stay_until_exclusive, '[)') WITH &&) WHERE (is_active);

-- FX: explicit versioned window with approver and provenance (T-FX-VENTANA). updated_at alone is not approval.
CREATE TABLE public.core1_fx_windows (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  pair text NOT NULL CHECK (pair = 'USD_DOP'),
  direction text NOT NULL CHECK (direction = 'DOP_PER_USD'),
  rate_sell numeric NOT NULL CHECK (rate_sell > 0),
  effective_from timestamptz NOT NULL, effective_until_exclusive timestamptz NOT NULL,
  CHECK (effective_until_exclusive > effective_from AND effective_until_exclusive - effective_from <= interval '24 hours'),
  approved_by_ref text NOT NULL, source_ref text NOT NULL,
  active boolean NOT NULL DEFAULT false, created_at timestamptz NOT NULL DEFAULT now(),
  EXCLUDE USING gist (tstzrange(effective_from, effective_until_exclusive, '[)') WITH &&) WHERE (active)
);

CREATE INDEX core1_base_rates_lookup_idx ON public.core1_base_rates (hotel_id, provider_id, room_map_id, stay_from, stay_until_exclusive) WHERE is_active;

-- Born locked: RLS on, no policies, no grants except service_role. No DELETE grant (new revision via supersedes_id).
ALTER TABLE public.core1_source_documents ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.core1_room_map ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.core1_base_rates ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.core1_fx_windows ENABLE ROW LEVEL SECURITY;
REVOKE ALL ON public.core1_source_documents, public.core1_room_map, public.core1_base_rates, public.core1_fx_windows FROM PUBLIC, anon, authenticated;
GRANT SELECT, INSERT, UPDATE ON public.core1_source_documents, public.core1_room_map, public.core1_base_rates, public.core1_fx_windows TO service_role;
COMMIT;
